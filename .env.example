# Server-side AI secret. Do not put the real value in git-tracked files.
# Recommended flow:
#   1) vercel link
#   2) vercel env add GROQ_API_KEY development preview production
#   3) npm run env:pull
GROQ_API_KEY=

# Optional override for screenshot/image parsing vision model(s).
# Example single model:
#   FORMMATE_IMAGE_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Example fallback chain:
#   FORMMATE_IMAGE_MODELS=meta-llama/llama-4-scout-17b-16e-instruct
FORMMATE_IMAGE_MODEL=
FORMMATE_IMAGE_MODELS=

# Comma-separated list for local/dev origins allowed to call the Vercel API proxy.
FORMMATE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local Vite -> Vercel proxy target used by `npm run dev:stack`.
VITE_API_PROXY_TARGET=http://127.0.0.1:3000

# Supabase client auth/storage configuration (required for non-dev auth).
# Replace <project_ref> with your Supabase project reference.
# Example URL:
#   VITE_SUPABASE_URL=https://<project_ref>.supabase.co
# Get the anon key from Supabase Dashboard -> Project Settings -> API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional explicit storage provider mode:
#   supabase -> remote profile/settings/vault/history sync
#   local    -> browser-only fallback
VITE_STORAGE_PROVIDER=supabase
