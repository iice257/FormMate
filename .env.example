# Server-side AI secret. Do not put the real value in git-tracked files.
# Recommended flow:
#   1) vercel link
#   2) vercel env add GROQ_API_KEY development preview production
#   3) npm run env:pull
GROQ_API_KEY=

# Comma-separated list for local/dev origins allowed to call the Vercel API proxy.
FORMMATE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local Vite -> Vercel proxy target used by `npm run dev:stack`.
VITE_API_PROXY_TARGET=http://127.0.0.1:3000
